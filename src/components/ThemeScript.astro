---
/**
 * Sets data-theme on <html> before the first paint so there is no flash of the
 * wrong theme. Must stay `is:inline` — anything Astro bundles gets deferred,
 * which is exactly the flash this exists to prevent.
 */
---

<script is:inline>
  (function () {
    var stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch (e) {
      /* private mode / storage disabled — fall through to the media query */
    }
    // First visit always opens in 5–9. The OS colour-scheme preference is
    // deliberately not consulted: the toggle picks a persona, not a skin, so
    // a dark-mode machine shouldn't land on the work side.
    var theme = stored === 'light' || stored === 'dark' ? stored : 'light';
    document.documentElement.dataset.theme = theme;
  })();
</script>
