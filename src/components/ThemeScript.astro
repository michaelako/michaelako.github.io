---
/**
 * Sets data-theme on <html> before the first paint so there is no flash of the
 * wrong theme. Must stay `is:inline` — anything Astro bundles gets deferred,
 * which is exactly the flash this exists to prevent.
 */
---

<script is:inline>
  (function () {
    var stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch (e) {
      /* private mode / storage disabled — fall through to the media query */
    }
    var theme =
      stored === 'light' || stored === 'dark'
        ? stored
        : window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
    document.documentElement.dataset.theme = theme;
  })();
</script>
