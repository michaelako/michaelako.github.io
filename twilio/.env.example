# Twilio Serverless environment variables (example)

# Twilio Sync
SYNC_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SYNC_MAP_NAME=sms_optins

# Messaging (prefer a Messaging Service for A2P/10DLC)
MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OR set FROM_NUMBER if not using a Messaging Service
FROM_NUMBER=+15555555555

# Program / copy overrides
PROGRAM_NAME=Michaela Kotarba Yoga Updates
SUPPORT_EMAIL=michaelakotarba@gmail.com
CONFIRMATION_MESSAGE=Michaela Kotarba Yoga Updates: Thanks for subscribing! Up to 4 msgs/month. Msg & data rates may apply. Reply HELP for help, STOP to cancel.

# CORS
ALLOWED_ORIGINS=https://michaelako.com,https://www.michaelako.com

